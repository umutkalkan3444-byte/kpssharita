# Sunucu tarafında saklayın; VITE_ öneki eklemeyin.
OPENAI_API_KEY=

# Yapay zekâlı kişisel incelemeyi açar. Kapalıyken doğrulanmış yerel özet kullanılır.
# Üretimde açmadan önce OpenAI projesinde düşük bir aylık hard spend limit belirleyin.
AI_STUDY_ENABLED=false
OPENAI_STUDY_MODEL=gpt-5-nano-2025-08-07

# Üretimde yalnızca kendi sitenizden gelen inceleme isteklerine izin verir.
APP_ORIGIN=https://kpssharita.lovable.app
